# OpenAI API — obbligatoria
OPENAI_API_KEY=your-openai-api-key-here

# Modello per estrazione principale (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Modello per il pass anchor (default: stesso di OPENAI_MODEL)
OPENAI_MODEL_ANCHOR=gpt-4o

# Provider LLM — 'openai' o 'gemini' (default: openai)
LLM_PROVIDER=openai

# Gemini API — obbligatoria se LLM_PROVIDER=gemini
# GEMINI_API_KEY=...

# Modello Gemini per estrazione principale (default: gemini-3-flash-preview)
# GEMINI_MODEL=gemini-3-flash-preview

# Modello Gemini per il pass anchor (default: stesso di GEMINI_MODEL)
# GEMINI_MODEL_ANCHOR=gemini-3-flash-preview

# Directory dati — screenshot e ground truth CSV (default: mnt/data)
INPUT_DIR=mnt/data

# Directory screenshot — se diversa da INPUT_DIR (default: stesso di INPUT_DIR)
# SCREENSHOT_DIR=mnt/data

# Parallelismo
PARALLEL_WORKERS=4
PARALLEL_ENABLED=1

# Massimo chiamate VLM per singolo screenshot (default: 4)
MAX_CALLS_PER_SCREEN=4

# Confidenza minima per accettare anchor NDG/DENOMINAZIONE (default: 0.95)
ANCHOR_CONF_MIN=0.95

# Fermare il processing se anchor e' incerto (default: 0 = no)
STOP_ON_ANCHOR_UNCERTAIN=0

# Salvare i crop intermedi su disco per debug (default: 0 = no)
DEBUG_SAVE_CROPS=0
