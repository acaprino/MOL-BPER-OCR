# Provider LLM — 'openai' o 'gemini' (default codice: openai; setup del progetto: gemini)
# Tenere allineato a src/edge-agent/defaults/env.template (template del pacchetto portable)
LLM_PROVIDER=gemini

# API key — obbligatoria (OpenAI o Gemini a seconda del provider)
LLM_API_KEY=your-api-key-here

# Modello per estrazione principale (default codice: gpt-4o)
LLM_MODEL=gemini-3.8-flash

# Modello per il pass anchor (default: stesso di LLM_MODEL)
# LLM_MODEL_ANCHOR=

# Directory dati — screenshot e ground truth CSV (default: data/reference)
INPUT_DIR=data/reference

# Parallelismo
PARALLEL_WORKERS=4
PARALLEL_ENABLED=1

# Screenshot simultanei nel solo Edge Agent. Accetta anche un numero, per esempio 2.
EDGE_AGENT_MAX_JOBS=auto
# EDGE_AGENT_JOB_TIMEOUT_SECONDS=600

# Massimo chiamate VLM per singolo screenshot: 1 anchor + 1 main + 1 retry per
# area di AREA_TO_FIELDS (default: 5, derivato dal numero di aree).
# Sotto 5 le aree in coda alla lista non vengono mai ritentate: su una pagina a
# sezione singola tutte le altre aree sembrano incomplete e consumano il budget.
MAX_CALLS_PER_SCREEN=5

# Confidenza minima per accettare anchor NDG/DENOMINAZIONE (default: 0.95)
ANCHOR_CONF_MIN=0.95

# Fermare il processing se anchor e' incerto (default: 0 = no)
STOP_ON_ANCHOR_UNCERTAIN=0

# Thinking level per Gemini 3+ — low/medium/high (default: nessuno, usa default modello)
# LLM_THINKING_LEVEL=low

# Salvare i crop intermedi su disco per debug (default: 0 = no)
DEBUG_SAVE_CROPS=0

# Catalogo prompt alternativo (default: la cartella prompts/ del progetto).
# Se valorizzata diventa l'unico candidato: nessun fallback, l'avvio fallisce
# se la cartella e' incompleta o malformata.
# PROMPTS_DIR=

# La replica e lo storico usano backup/ accanto allo script o a EdgeAgent.exe.
# Un percorso assoluto può indicare un secondo disco.
# EDGE_AGENT_RECOVERY_DIR=C:\BPER\sessioni
# EDGE_AGENT_BACKUP_DIR=backup
# EDGE_AGENT_PRIORITY=above_normal
